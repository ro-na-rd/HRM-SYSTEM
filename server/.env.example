# Copy this file to .env and fill in real values before running the server.
# Never commit the real .env file.

PORT=4000

# Leave unset (or 127.0.0.1) for local single-machine use — the server will
# only be reachable from this computer. Set to 0.0.0.0 ONLY when deploying to
# a real server behind a reverse proxy (see README "Deploying to a server").
HOST=127.0.0.1

# Leave unset (or "development") for local use. Set to "production" when
# deployed to a real server — this enables secure cookies (requires HTTPS),
# trusts the reverse proxy for client IPs, and serves the built frontend
# from this same server instead of expecting a separate Vite dev server.
NODE_ENV=development

# Random secret used to sign login sessions (JWT). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# 32-byte (64 hex chars) key used to encrypt documents at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: back this key up somewhere safe (outside this folder). If it is lost,
# every stored document becomes permanently unreadable.
ENCRYPTION_KEY=

# --- Azul Tech SSO (optional) ---
# Adds a "Continue with Azul Tech SSO" button to the login page, alongside
# the existing email/password form. Leave all four blank to disable it
# entirely — the server skips SSO setup and only the password form shows.
# Register this app's client with:
#   sso/keycloak/scripts/register-app.sh hrm "Azul Tech People" "<APP_ORIGIN>/api/auth/sso/callback"
# then paste the printed values below. See sso/docs/hrm-integration.md.
#
# First SSO login for an email with no existing HRM account auto-creates
# one at 'employee' (or 'admin', see BOOTSTRAP_ADMIN_EMAILS below) — never
# 'hr'. HR/Admin access beyond that bootstrap is always a deliberate
# promotion an Admin makes in User Accounts, same as today.
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
# Must exactly match the redirect URIs registered on the Keycloak client.
# Comma-separated so both `npm run dev` (:5173 via Vite proxy) and
# `docker compose up` (:4000, API serves the UI) work with one config.
# Register EVERY entry in Keycloak as a Valid Redirect URI (exact match).
KEYCLOAK_REDIRECT_URI=http://localhost:4000/api/auth/sso/callback,http://localhost:5173/api/auth/sso/callback
# Exact URLs Keycloak may redirect to after RP-initiated logout. Register
# each one in the Keycloak client alongside KEYCLOAK_REDIRECT_URI.
KEYCLOAK_POST_LOGOUT_REDIRECT_URI=http://localhost:4000/login,http://localhost:5173/login
# URL the server uses to *reach* Keycloak for OIDC discovery.  In Docker
# this differs from KEYCLOAK_ISSUER because "localhost" inside a container
# is itself — use host-gateway or the container name instead.  Ignored
# when running outside Docker (leave blank to default to KEYCLOAK_ISSUER).
KEYCLOAK_SERVER_URL=
# Comma-separated emails that start as (or get promoted to) 'admin' instead
# of 'employee' the first time they sign in via SSO — same name/behaviour as
# Lunchify's BOOTSTRAP_ADMIN_EMAILS (its README has the full explanation):
# only ever promotes, never demotes, and only matters on login, so leaving
# it set afterward is harmless. e.g. u.yvonne@azultech.rw
BOOTSTRAP_ADMIN_EMAILS=
# Comma-separated emails that sign in as a team MANAGER instead of a plain
# employee. A manager gets her own dashboard (Dashboard, Employees,
# Attendance, Leave Management) to keep her own team, who have no login.
# Her team is hidden from HR/Admin. Only lifts plain employees - someone
# Keycloak maps to HR/Admin keeps that role. Keycloak groups
# /App-Access/HRM/Managers or /App-Access/people/Manager do the same.
MANAGER_EMAILS=

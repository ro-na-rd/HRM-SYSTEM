# Copy this file to .env and fill in real values before running the server.
# Never commit the real .env file.

PORT=4000

# Leave unset (or 127.0.0.1) for local single-machine use — the server will
# only be reachable from this computer. Set to 0.0.0.0 ONLY when deploying to
# a real server behind a reverse proxy (see README "Deploying to a server").
HOST=127.0.0.1

# Leave unset (or "development") for local use. Set to "production" when
# deployed to a real server — this enables secure cookies (requires HTTPS),
# trusts the reverse proxy for client IPs, and serves the built frontend
# from this same server instead of expecting a separate Vite dev server.
NODE_ENV=development

# Random secret used to sign login sessions (JWT). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# 32-byte (64 hex chars) key used to encrypt documents at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: back this key up somewhere safe (outside this folder). If it is lost,
# every stored document becomes permanently unreadable.
ENCRYPTION_KEY=

# Copy this file to .env and fill in real values before running the server.
# Never commit the real .env file.

PORT=4000

# Random secret used to sign login sessions (JWT). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=a0be2783f262d0d0b027b7dc265f68f4e25cf7eeabf14322ad45cddedda28d2537416999a2d7ae4dc31645f6d7208ded

# 32-byte (64 hex chars) key used to encrypt documents at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: back this key up somewhere safe (outside this folder). If it is lost,
# every stored document becomes permanently unreadable.
ENCRYPTION_KEY=bd2f56a6de37c9d6762d583938891f5fe2bfbb778e4abb9bd003a7662ec2ff27

# --- Azul Tech SSO ("Continue with Azul Tech SSO" on the login page) ---
# Registered via sso/keycloak/scripts/register-app.sh — see sso/docs/hrm-integration.md.
# Dev values below point at the local Keycloak (docker compose in the sso repo).
KEYCLOAK_ISSUER=http://localhost:8081/realms/azultech
KEYCLOAK_CLIENT_ID=hrm
KEYCLOAK_CLIENT_SECRET=ms8vt7kPvpUTRjRHzj12pZOE0xqrp7R4T1X1PTQ05dLLtl6vSLVU44Y0kS2rXpv4ID7YMYw9dgCKBncGK92eeF
# Must exactly match the redirect URI registered on the Keycloak client.
# Currently set for `docker compose up` (single container on :4000, no Vite
# dev proxy). Switching to `npm run dev` instead: change this back to
# http://localhost:5173/api/auth/sso/callback AND comment out
# KEYCLOAK_SERVER_URL below — then re-run register-app.sh with whichever
# redirect URI you're using, since Keycloak only accepts an exact match.
KEYCLOAK_REDIRECT_URI=http://localhost:4000/api/auth/sso/callback
KEYCLOAK_POST_LOGOUT_REDIRECT_URI=http://localhost:4000/login
# Only needed when running inside Docker (docker compose up), where
# "localhost" inside the container means the container itself, not the host
# running Keycloak. docker-compose.yml adds the extra_hosts entry that makes
# this resolve. Leave commented out for `npm run dev` (runs on the host, so
# plain localhost:8081 already works — see KEYCLOAK_ISSUER above).
# Host-based development uses KEYCLOAK_ISSUER directly. Set this only when
# running the server inside Docker and Keycloak is reachable via the host.
KEYCLOAK_SERVER_URL=http://host.docker.internal:8081
# Comma-separated: starts (or promotes) these emails as 'admin' on SSO login.
BOOTSTRAP_ADMIN_EMAILS=u.yvonne@azultech.rw
